runs/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
wandb/

# ---- Run-time logs (contain full API responses) ----
agent_log.txt
*.log

# ---- Reports and office files (keep graded write-ups out of the repo) ----
*.docx
*.pptx
*.xlsx
~$*

# ---- OS / editor / sync clutter ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
