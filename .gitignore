# ---- Secrets: never commit ----
.env
.env.*
!.env.example
*.key
*.pem
secrets*.json
credentials*.json

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

